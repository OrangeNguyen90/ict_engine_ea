   StringReplace(text,"Configured closed-bar age reached","Đã đạt giới hạn số nến đóng");
   StringReplace(text,"New event starts a separate setup","Sự kiện mới bắt đầu một thiết lập riêng");
   StringReplace(text,"New confirmed structural leg","Đã xác nhận nhịp cấu trúc mới");
   StringReplace(text,"Confirmed HTF structural leg; bounded replay","Đã xác nhận nhịp cấu trúc HTF trong lịch sử phân tích");
   StringReplace(text,"Excursion candidate; no reversal confirmation","Có dấu hiệu vượt vùng; chưa xác nhận đảo chiều");
   StringReplace(text,"Price near external pool","Giá đang gần vùng thanh khoản ngoài");
   StringReplace(text,"Both external sides swept on one candle","Cả hai phía thanh khoản ngoài bị quét trong một nến");
   StringReplace(text,"Sweep setup exceeded equivalent MTF age in closed LTF bars","Thiết lập quét đã vượt thời hạn MTF tính theo số nến LTF đóng");
   StringReplace(text,"Closed excursion observed","Đã ghi nhận nến đóng vượt vùng");
   StringReplace(text,"Closed external reclaim; ","Nến đóng trở lại sau khi quét ngoài; ");
   StringReplace(text,"; awaiting structure","; chờ cấu trúc");
   StringReplace(text,"Closed internal sweep and reclaim in HTF direction; awaiting later structure","Nến đóng trở lại sau quét nội bộ cùng hướng HTF; chờ cấu trúc tiếp theo");
   StringReplace(text,"Continuation invalidated the sweep thesis","Chuyển động tiếp diễn làm giả thuyết quét mất hiệu lực");
   StringReplace(text,"Closed beyond sweep invalidation","Nến đóng vượt ngưỡng mất hiệu lực của lần quét");
   StringReplace(text,"Aligned closed structure and displacement","Cấu trúc nến đóng và dịch chuyển giá cùng hướng");
   StringReplace(text,"Opposite confirmed MTF break","Phá cấu trúc MTF ngược hướng đã xác nhận");
   StringReplace(text,"Neutral/opposing HTF structure; no actionable rotation","Cấu trúc HTF trung tính / ngược hướng; chưa có kịch bản hành động");
   StringReplace(text,"Awaiting aligned post-event MTF structure/displacement","Chờ cấu trúc / dịch chuyển MTF cùng hướng sau sự kiện");
   StringReplace(text,"No eligible same-range internal PD array","Không có vùng giá nội bộ phù hợp trong cùng khoảng giá");
   StringReplace(text,"Entry array expired, fully mitigated or invalidated","Vùng vào lệnh hết hạn, đã lấp hết hoặc mất hiệu lực");
   StringReplace(text,"Closed retracement into selected internal PD array","Nến đóng hồi về vùng giá nội bộ đã chọn");
   StringReplace(text,"Closed directional rejection after IRL touch","Nến đóng phản ứng theo hướng sau khi chạm IRL");
   StringReplace(text,"Target touched during reaction candle; intrabar order is unknown","Mục tiêu bị chạm trong nến phản ứng; chưa rõ trình tự trong nến");
   StringReplace(text,"Confirmed later closed bar reached scenario target","Nến đóng sau đó đã chạm mục tiêu kịch bản");
   StringReplace(text,"Confirmed rotation; proposed zone entry awaits risk/score gates","Đã xác nhận chuyển động; vùng vào đề xuất chờ kiểm tra rủi ro / điểm");
   StringReplace(text,"Scenario target consumed/unavailable","Mục tiêu kịch bản đã dùng hoặc không còn khả dụng");
   StringReplace(text,"Awaiting closed IRL reaction and eligible ERL target","Chờ nến đóng phản ứng tại IRL và mục tiêu ERL phù hợp");
   StringReplace(text,"Nearest unconsumed same-range ERL: ","ERL gần nhất chưa dùng trong cùng vùng: ");
   StringReplace(text,"; conditional, not a forecast","; có điều kiện, không phải dự báo");
   if(text==source) return "Chi tiết gốc: "+source;
   return text;
  }
