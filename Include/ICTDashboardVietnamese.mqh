   StringReplace(text," close="," nến đóng=");
   StringReplace(text," broker="," thời gian sàn=");
   StringReplace(text,"Range plan geometry or gross RR below minimum; costs can only reduce RR further","Vị trí giá hoặc RR gộp của kế hoạch chưa đạt; chi phí chỉ làm RR giảm thêm");
   StringReplace(text,"Missing/stale/inverted market quote","Báo giá thiếu, đã cũ hoặc bị đảo");
   StringReplace(text,"Required range evidence missing or wrong owner","Thiếu bằng chứng của vùng hoặc bằng chứng không thuộc vùng hiện tại");
   StringReplace(text,"Live quote crossed scenario stop after the closed reaction","Báo giá hiện tại đã vượt dừng lỗ sau nến phản ứng");
   StringReplace(text,"Live exit quote already reached or crossed the scenario target","Báo giá thoát hiện tại đã chạm hoặc vượt mục tiêu kịch bản");
   StringReplace(text,"Spread or symbol point invalid","Chênh lệch giá hoặc đơn vị điểm của mã không hợp lệ");
   StringReplace(text,"Invalid risk configuration: RR >=2 and maximum risk <=2% required","Cấu hình rủi ro không hợp lệ: cần RR từ 2 và rủi ro tối đa không quá 2%");
   StringReplace(text,"Confirmed IRL/ERL advisory plan; proposed zone entry is not a fill or order","Kế hoạch IRL / ERL tham khảo đã xác nhận; giá đề xuất chưa phải lệnh hoặc giá khớp");
   StringReplace(text,"Confluence below configured threshold","Điểm hợp lưu dưới ngưỡng đã đặt");
   StringReplace(text,"Risk gate: ","Điều kiện rủi ro: ");
   StringReplace(text,"Calculation unavailable","Chưa tính được rủi ro");
   StringReplace(text,"Symbol unavailable","Mã giao dịch không khả dụng");
