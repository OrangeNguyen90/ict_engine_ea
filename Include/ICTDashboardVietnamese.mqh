   StringReplace(text,"Nonpositive loss or reward estimate","Ước tính lỗ hoặc lợi nhuận không dương");
   StringReplace(text,"Minimum lot exceeds risk budget","Khối lượng tối thiểu vượt ngân sách rủi ro");
   StringReplace(text,"No lot fits risk budget","Không có khối lượng phù hợp ngân sách rủi ro");
