#ifndef ICT_DASHBOARD_VIETNAMESE_MQH
#define ICT_DASHBOARD_VIETNAMESE_MQH

// Presentation only: the engine, alerts, journals and machine-readable IDs
// retain their original values. Unknown diagnostics stay visible verbatim.
string ICTDashboardText(const string source)
  {
   if(source=="") return "--";
   if(source=="N/A" || source=="unavailable" || source=="UNAVAILABLE") return "Chưa có";
   if(source=="DISABLED") return "Đã tắt";
   if(source=="RELATION_UNKNOWN") return "Chưa rõ tương quan";
   if(source=="NO COMPARATOR") return "Chưa có mã so sánh";
   if(source=="CONFIRMED PIVOT REPLAY") return "Đã xác nhận điểm xoay";
   if(source=="CONFIRMED PIVOT") return "Đã xác nhận điểm xoay";
   if(source=="INSUFFICIENT_DATA" || source=="DATA INSUFFICIENT") return "Không đủ dữ liệu";
   if(source=="BULLISH") return "Tăng";
   if(source=="BEARISH") return "Giảm";
   if(source=="NEUTRAL" || source=="neutral") return "Trung tính";
   if(source=="UNKNOWN" || source=="Unknown") return "Chưa rõ";
   if(source=="NONE" || source=="none") return "Không có";
   if(source=="PREMIUM") return "Vùng giá cao (Premium)";
   if(source=="DISCOUNT") return "Vùng giá thấp (Discount)";
   if(source=="EQUILIBRIUM") return "Điểm cân bằng";
   if(source=="OUTSIDE") return "Ngoài vùng giá";
   if(source=="Fresh") return "Chưa chạm";
   if(source=="BREAKER") return "Breaker (vùng đảo chiều)";
   if(source=="Touched/partial") return "Đã chạm một phần";
   if(source=="Fully mitigated/expired") return "Đã lấp hết / hết hạn";
   if(source=="Invalidated") return "Đã mất hiệu lực";
   if(source=="RANGE_IDENTIFIED") return "Đã xác định vùng giá";
   if(source=="ERL_APPROACH") return "Đang tiến tới ERL";
   if(source=="ERL_SWEEP_CANDIDATE") return "Có dấu hiệu quét ERL";
   if(source=="ERL_SWEEP_CONFIRMED") return "Đã xác nhận quét ERL";
   if(source=="STRUCTURE_SHIFT_CONFIRMED") return "Đã xác nhận chuyển cấu trúc";
   if(source=="IRL_RETRACEMENT") return "Đang hồi về IRL";
   if(source=="IRL_REACTION_CONFIRMED") return "Đã xác nhận phản ứng tại IRL";
   if(source=="ERL_TARGETING") return "Đang hướng tới ERL";
   if(source=="TARGET_REACHED") return "Đã chạm mục tiêu";
   if(source=="SETUP_INVALIDATED") return "Thiết lập đã mất hiệu lực";
   if(source=="UNTOUCHED") return "Chưa chạm";
   if(source=="APPROACHING") return "Đang tiến gần";
   if(source=="SWEPT") return "Đã quét";
   if(source=="BREAKOUT") return "Đã phá vỡ";
   if(source=="CONSUMED") return "Đã sử dụng";
   if(source=="INVALIDATED") return "Đã mất hiệu lực";
   if(source=="LIQUIDITY_SWEEP") return "Quét thanh khoản";
   if(source=="BREAKOUT_CONFIRMED") return "Đã xác nhận phá vỡ";
   if(source=="FALSE_BREAKOUT") return "Phá vỡ giả";
   if(source=="RETEST_CONFIRMED") return "Đã xác nhận kiểm tra lại";
   if(source=="LIQUIDITY_SWEEP / MSS") return "Quét thanh khoản / MSS";
   if(source=="BREAKOUT_CONFIRMED / RETEST") return "Phá vỡ đã xác nhận / kiểm tra lại";
   if(source=="MTF SETUP / LTF RETEST") return "Thiết lập MTF / kiểm tra lại LTF";
   if(source=="STRONG") return "Mạnh";
   if(source=="MODERATE") return "Trung bình";
   if(source=="WEAK") return "Yếu";
   if(source=="CANDIDATE") return "Đang hình thành";
   if(source=="CONFIRMED") return "Đã xác nhận";
   if(source=="ACTIVE") return "Đang hoạt động";
   if(source=="TOUCHED") return "Đã chạm";
   if(source=="PARTIALLY MITIGATED") return "Đã lấp một phần";
   if(source=="MITIGATED") return "Đã lấp";
   if(source=="EXPIRED") return "Hết hạn";
   if(source=="Weekend") return "Cuối tuần";
   if(source=="London kill zone") return "Khung giờ trọng điểm London";
   if(source=="New York AM kill zone") return "Khung giờ trọng điểm New York sáng";
   if(source=="New York PM kill zone") return "Khung giờ trọng điểm New York chiều";
   if(source=="London/Asia transition") return "Chuyển phiên Á / London";
   if(source=="New York midday") return "Giữa phiên New York";
   if(source=="London close/NY late") return "Đóng cửa London / cuối phiên New York";
   if(source=="Asia") return "Phiên Á";

   string text=source;
   StringReplace(text,"DATA INSUFFICIENT: three closed timeframe tiers required","Không đủ dữ liệu: cần ba khung thời gian có nến đóng");
   StringReplace(text,"DATA INSUFFICIENT: three independent tiers required for confirmation","Không đủ dữ liệu: cần ba khung độc lập để xác nhận");
   StringReplace(text,"NO_TRADE: HTF bias / MTF setup / LTF execution direction conflict","Không giao dịch: xu hướng HTF, thiết lập MTF và hướng LTF xung đột");
   StringReplace(text,"NO_TRADE: HTF bias / MTF setup conflict or missing","Không giao dịch: thiếu hoặc xung đột xu hướng HTF / thiết lập MTF");
   StringReplace(text,"NO_TRADE: required SMT unavailable, conflicting or unaligned","Không giao dịch: SMT bắt buộc không có dữ liệu, xung đột hoặc không cùng hướng");
   StringReplace(text,"NO_TRADE: live plan differs from committed signal or failed recheck","Không giao dịch: kế hoạch hiện tại khác tín hiệu đã lưu hoặc không vượt kiểm tra lại");
   StringReplace(text,"NO_TRADE: confirmed signal journal unavailable","Không giao dịch: không đọc được nhật ký tín hiệu đã xác nhận");
   StringReplace(text,"WATCH: waiting for a valid closed LTF trigger","Theo dõi: chờ tín hiệu LTF hợp lệ trên nến đã đóng");
   StringReplace(text,"RISK FILTER FAIL: invalid plan or net RR below configured minimum","Bộ lọc rủi ro không đạt: kế hoạch không hợp lệ hoặc RR ròng dưới mức tối thiểu");
   StringReplace(text,"RISK FILTER FAIL on live recheck; historical ","Kiểm tra rủi ro hiện tại không đạt; tín hiệu lịch sử ");
   StringReplace(text," unchanged"," giữ nguyên");
   StringReplace(text,"BUY_CONFIRMED","MUA ĐÃ XÁC NHẬN");
   StringReplace(text,"SELL_CONFIRMED","BÁN ĐÃ XÁC NHẬN");
   StringReplace(text,"WATCH_BUY","THEO DÕI MUA");
   StringReplace(text,"WATCH_SELL","THEO DÕI BÁN");
   StringReplace(text,"NO_TRADE","KHÔNG GIAO DỊCH");
   StringReplace(text,"TARGET UNAVAILABLE: no fresh same-range ERL or retained LTF coverage incomplete","Chưa có mục tiêu: không có ERL mới cùng vùng hoặc lịch sử LTF chưa đủ");
   StringReplace(text,"TARGET UNAVAILABLE: source breakout failed; ","Chưa có mục tiêu: phá vỡ tại nguồn thất bại; ");
   StringReplace(text,"TARGET UNAVAILABLE","Chưa có mục tiêu");
   StringReplace(text,"INSUFFICIENT_DATA: one or more mapped tiers lack closed confirmed history","Không đủ dữ liệu: một hoặc nhiều khung thiếu lịch sử nến đóng đã xác nhận");
   StringReplace(text,"INSUFFICIENT_DATA: decision and shared snapshot timestamps differ","Không đủ dữ liệu: thời điểm quyết định và dữ liệu tổng hợp khác nhau");
   StringReplace(text,"INSUFFICIENT_DATA: no MTF structure closed by the LTF snapshot","Không đủ dữ liệu: chưa có cấu trúc MTF đóng tại thời điểm LTF");
   StringReplace(text,"INSUFFICIENT_DATA: waiting for closed history (","Đang tải lịch sử nến đóng (cần ");
   StringReplace(text," bars)"," nến)");
   StringReplace(text,"INSUFFICIENT_DATA: confirmed swings missing","Chưa đủ đỉnh/đáy đã xác nhận");
   StringReplace(text,"INSUFFICIENT_DATA: chart display window history missing","Không đủ dữ liệu: thiếu lịch sử trong cửa sổ biểu đồ");
   StringReplace(text,"INSUFFICIENT_DATA: no closed chart candle","Không đủ dữ liệu: chưa có nến biểu đồ đóng");
   StringReplace(text,"INSUFFICIENT_DATA: symbol tick size missing","Không đủ dữ liệu: thiếu bước giá của mã");
   StringReplace(text,"INSUFFICIENT_DATA: primary history","Không đủ dữ liệu lịch sử của mã chính");
   StringReplace(text,"INSUFFICIENT_DATA: comparator history","Không đủ dữ liệu lịch sử của mã so sánh");
   StringReplace(text,"INSUFFICIENT_DATA: comparator tick size","Không đủ dữ liệu bước giá của mã so sánh");
   StringReplace(text,"INSUFFICIENT_DATA: timestamps not aligned","Không đủ dữ liệu: thời gian hai mã chưa khớp");
   StringReplace(text,"N/A: comparator unavailable","Chưa có mã so sánh");
   StringReplace(text,"PARTIAL: unavailable peer; available peer retained","Dữ liệu một phần: giữ mã so sánh có dữ liệu");
   StringReplace(text,"SMT_CONFLICT: both live directions","SMT xung đột: có tín hiệu theo cả hai hướng");
   StringReplace(text,"NONE: no active divergence","Không có phân kỳ đang hoạt động");
   StringReplace(text,"UNAVAILABLE: shared snapshot invalid","Không có dữ liệu: ảnh chụp phân tích không hợp lệ");
   StringReplace(text,"UNKNOWN: decision direction unavailable","Chưa rõ: chưa xác định được hướng quyết định");
   StringReplace(text,"UNAVAILABLE: SMT analysis disabled or no timeframe","Không có dữ liệu: phân tích SMT đã tắt hoặc thiếu khung thời gian");
   StringReplace(text,"CONFLICT: opposing active divergences","Xung đột: có các phân kỳ ngược hướng");
   StringReplace(text,"ALIGNED: active divergence supports direction","Cùng hướng: phân kỳ đang ủng hộ hướng phân tích");
   StringReplace(text,"OPPOSITE: active divergence opposes direction","Ngược hướng: phân kỳ không ủng hộ hướng phân tích");
   StringReplace(text,"UNAVAILABLE: no usable comparator data","Không có dữ liệu mã so sánh sử dụng được");
   StringReplace(text," (some peer data unavailable)"," (thiếu dữ liệu một số mã so sánh)");
   StringReplace(text," | optional, no veto"," | tùy chọn, không phủ quyết");
   StringReplace(text," | required"," | bắt buộc");
   StringReplace(text,": configured comparator unavailable",": mã so sánh đã cấu hình không khả dụng");
   StringReplace(text,"Duplicate comparator slot disabled","Đã tắt mã so sánh trùng lặp");
   StringReplace(text,"SMT event capacity reached; no candidate until history is reviewed","Đã đầy lịch sử sự kiện SMT; cần kiểm tra lịch sử trước khi xét tín hiệu mới");
   StringReplace(text,"OB capacity reached; no candidate until history is reviewed","Đã đầy lịch sử OB; cần kiểm tra lịch sử trước khi xét tín hiệu mới");
   StringReplace(text,"Invalid unified settings","Cấu hình phân tích tổng hợp không hợp lệ");
   StringReplace(text,"Closed as-of shared snapshot","Dữ liệu tổng hợp tại thời điểm nến đóng");
   StringReplace(text,"SMT payload journal corrupt/unavailable: frozen confirmation history cannot be restored","Nhật ký SMT bị lỗi hoặc không khả dụng; không thể khôi phục lịch sử xác nhận");
   StringReplace(text,"SMT payload journal commit failed: uncommitted history is unavailable","Không thể lưu nhật ký SMT; lịch sử chưa được lưu không khả dụng");
   StringReplace(text,"Event journal unavailable; history retention cannot be guaranteed","Nhật ký sự kiện không khả dụng; không thể bảo đảm lưu lịch sử");
   StringReplace(text,"TWO TIER CONTEXT: no HTF; MTF is upper context","Bối cảnh hai khung: không có HTF; dùng MTF làm bối cảnh lớn");
   StringReplace(text,"ONE TIER CONTEXT: advisory entry disabled","Bối cảnh một khung: tắt đề xuất vào lệnh");
   StringReplace(text,"Reduced-tier context available; waiting for a supported execution/risk plan","Chỉ có bối cảnh ít khung; chờ kế hoạch vào lệnh và rủi ro phù hợp");
   StringReplace(text,"Upper timeframe bias NEUTRAL","Xu hướng khung lớn trung tính");
   StringReplace(text,"Risk Manager veto: invalid plan or net RR below 1:2","Bộ quản lý rủi ro từ chối: kế hoạch không hợp lệ hoặc RR ròng dưới 1:2");
   StringReplace(text,"WAIT: legacy OB entry is not an active shared OB with valid hard gates","Chờ: vùng vào OB chưa hoạt động hoặc chưa đạt điều kiện bắt buộc");
   StringReplace(text,"WAIT: MTF structure neutral/counter-trend or LTF setup conflicts with HTF","Chờ: cấu trúc MTF trung tính / ngược xu hướng hoặc LTF xung đột HTF");
   StringReplace(text,"Waiting for two confirmed sweeps of the same active pool","Chờ hai lần quét đã xác nhận tại cùng một vùng thanh khoản");
   StringReplace(text,"HTF bias neutral","Xu hướng HTF trung tính");
   StringReplace(text,"bias missing/conflict","thiếu hoặc xung đột xu hướng");
   StringReplace(text,"setup missing/conflict","thiếu hoặc xung đột thiết lập");
   StringReplace(text,"bullish structure + valid zone","cấu trúc tăng và vùng giá hợp lệ");
   StringReplace(text,"bearish structure + valid zone","cấu trúc giảm và vùng giá hợp lệ");
   StringReplace(text,"neutral structure + valid zone","cấu trúc trung tính và vùng giá hợp lệ");
   StringReplace(text,"bullish bias","xu hướng tăng");
   StringReplace(text,"bearish bias","xu hướng giảm");
   StringReplace(text,"neutral bias","xu hướng trung tính");
   StringReplace(text,"closed zone reaction after setup displacement","nến đóng phản ứng tại vùng sau dịch chuyển giá");
   StringReplace(text,"closed zone reaction after MSS and displacement","nến đóng phản ứng tại vùng sau MSS và dịch chuyển giá");
   StringReplace(text,"closed reaction / setup chronology missing","thiếu phản ứng nến đóng hoặc trình tự thiết lập");
   StringReplace(text,"HTF PERIOD_","HTF ");
   StringReplace(text,"MTF PERIOD_","MTF ");
   StringReplace(text,"LTF PERIOD_","LTF ");
   StringReplace(text,"Insufficient confirmed evidence","Chưa đủ tín hiệu đã xác nhận");
   StringReplace(text,"Invalid confluence configuration","Cấu hình hợp lưu không hợp lệ");
   StringReplace(text,"Invalid configuration","Cấu hình không hợp lệ");
   StringReplace(text,"Missing, duplicate or invalid closed candles","Thiếu, trùng hoặc có nến đóng không hợp lệ");
   StringReplace(text,"Required D1 structure unavailable","Chưa có cấu trúc D1 bắt buộc");
   StringReplace(text,"Higher-timeframe structure unavailable","Chưa có cấu trúc khung thời gian lớn");
   StringReplace(text,"Severe D1/HTF/LTF structure conflict","Cấu trúc D1 / HTF / LTF xung đột nghiêm trọng");
   StringReplace(text,"HTF bias is neutral","Xu hướng HTF trung tính");
   StringReplace(text,"Quote unavailable, inverted, future or stale","Báo giá thiếu, giá mua / bán bị đảo, sai thời gian hoặc đã cũ");
   StringReplace(text,"Invalid symbol specification","Thông số mã giao dịch không hợp lệ");
   StringReplace(text,"No eligible DOL target","Không có mục tiêu DOL phù hợp");
   StringReplace(text,"Liquidity history unavailable","Chưa có lịch sử thanh khoản");
   StringReplace(text,"Incomplete sweep history","Lịch sử quét thanh khoản chưa đầy đủ");
   StringReplace(text,"Awaiting aligned confirmed liquidity sweep","Chờ quét thanh khoản đã xác nhận và cùng hướng");
   StringReplace(text,"Sweep expired","Tín hiệu quét đã hết hạn");
   StringReplace(text,"Awaiting post-sweep MSS","Chờ MSS sau khi quét thanh khoản");
   StringReplace(text,"ATR unavailable","Chưa có ATR");
   StringReplace(text,"Awaiting post-MSS active FVG or Order Block","Chờ FVG hoặc OB còn hiệu lực sau MSS");
   StringReplace(text,"Awaiting post-MSS active Order Block","Chờ OB còn hiệu lực sau MSS");
   StringReplace(text,"Entry zone expired","Vùng vào lệnh đã hết hạn");
   StringReplace(text,"OB displacement not confirmed","Chưa xác nhận dịch chuyển giá của OB");
   StringReplace(text,"Displacement not confirmed","Chưa xác nhận dịch chuyển giá");
   StringReplace(text,"FVG outside discount/premium","FVG nằm ngoài vùng giá cao / thấp phù hợp");
   StringReplace(text,"Awaiting FVG retest","Chờ giá kiểm tra lại FVG");
   StringReplace(text,"Awaiting Order Block retest","Chờ giá kiểm tra lại OB");
   StringReplace(text,"Entry/stop/target geometry invalid","Vị trí vào lệnh / dừng lỗ / mục tiêu không hợp lệ");
   StringReplace(text,"Matching account position is active","Đã có vị thế tương ứng trên tài khoản");
   StringReplace(text,"Protection offline, unhealthy, disabled or locked","Bảo vệ đang ngoại tuyến, gặp lỗi, bị tắt hoặc khóa");
   StringReplace(text,"Protection offline, unhealthy or locked","Bảo vệ đang ngoại tuyến, gặp lỗi hoặc bị khóa");
   StringReplace(text,"Spread exceeds limit","Chênh lệch giá vượt giới hạn");
   StringReplace(text,"Daily loss limit or account history unavailable","Vượt giới hạn lỗ ngày hoặc không có lịch sử tài khoản");
   StringReplace(text,"Daily loss gate or deal history unavailable","Điều kiện lỗ ngày không đạt hoặc không có lịch sử giao dịch");
   StringReplace(text,"Confirmed sweep, MSS, displacement, entry-zone retest, DOL and risk gates","Đã xác nhận quét, MSS, dịch chuyển giá, kiểm tra lại vùng vào, DOL và rủi ro");
   StringReplace(text,"Mandatory SMT/session evidence missing","Thiếu xác nhận SMT / phiên giao dịch bắt buộc");
   StringReplace(text,"Missing required evidence, score threshold or directional conflict","Thiếu xác nhận, chưa đạt điểm tối thiểu hoặc có xung đột hướng");
   StringReplace(text,"Optional SMT absent/unavailable/unaligned; no SMT points","SMT tùy chọn không có hoặc không cùng hướng; không cộng điểm SMT");
   StringReplace(text,"SMT absent/unavailable/unaligned; no SMT points awarded","SMT không có hoặc không cùng hướng; không cộng điểm SMT");
   StringReplace(text,"Closed chronological HTF/MTF/LTF range snapshot","Dữ liệu vùng HTF / MTF / LTF theo thứ tự nến đóng");
   StringReplace(text,"Closed-bar inputs available; session uses explicit UTC conversion in Tester","Đã có dữ liệu nến đóng; phiên giao dịch dùng chuyển đổi UTC trong Tester");
   StringReplace(text,"Missing or invalid inputs; see reason and evidence masks","Dữ liệu đầu vào thiếu hoặc không hợp lệ; xem lý do và bằng chứng");
   StringReplace(text,"Invalid range settings/tick","Cấu hình vùng giá hoặc bước giá không hợp lệ");
   StringReplace(text,"Missing or malformed chronological closed data","Thiếu dữ liệu nến đóng hoặc thứ tự dữ liệu không hợp lệ");
   StringReplace(text,"No confirmed HTF range at this LTF close","Chưa có vùng HTF được xác nhận tại thời điểm nến LTF đóng");
   StringReplace(text,"Boundary pivot confirmation follows its range confirmation","Điểm xoay biên được xác nhận sau thời điểm xác nhận vùng giá");
   StringReplace(text,"Range endpoints moved backward; reinitialize required","Mốc biên vùng giá lùi về trước; cần khởi tạo lại");
   StringReplace(text,"Confirmed range revised; reset required","Vùng giá đã xác nhận bị sửa đổi; cần khởi tạo lại");
   StringReplace(text,"Invalid tick, ATR or historical spread for liquidity tolerance","Bước giá, ATR hoặc chênh lệch giá lịch sử không hợp lệ để tính ngưỡng thanh khoản");
   StringReplace(text,"IRL/ERL disabled","Phân tích IRL / ERL đã tắt");
   StringReplace(text,"Invalid IRL/ERL configuration","Cấu hình IRL / ERL không hợp lệ");
   StringReplace(text,"Closed history revised; reinitialize and audit replay","Lịch sử nến đóng đã sửa đổi; cần khởi tạo lại và kiểm tra phân tích");
   StringReplace(text,"Incomplete closed HTF/MTF/LTF history","Lịch sử nến đóng HTF / MTF / LTF chưa đầy đủ");
   StringReplace(text,"Broker revised observed closed candles; reset required","Sàn đã sửa dữ liệu nến đóng; cần khởi tạo lại");
   StringReplace(text,"Replay gap exceeds retained history; reinitialize required","Khoảng trống phân tích vượt lịch sử lưu giữ; cần khởi tạo lại");
   StringReplace(text,"Invalid symbol point for historical spread","Đơn vị điểm của mã không hợp lệ để tính chênh lệch giá lịch sử");
   StringReplace(text,"Broker revised observed liquidity history; reset required","Sàn đã sửa lịch sử thanh khoản; cần khởi tạo lại");
   StringReplace(text,"Confirmed structural leg unavailable in retained history","Không có nhịp cấu trúc đã xác nhận trong lịch sử lưu giữ");
   StringReplace(text,"Prior D/W/M liquidity history unavailable","Không có lịch sử thanh khoản ngày / tuần / tháng trước");
   StringReplace(text,"Invalid SYMBOL_TRADE_TICK_SIZE","Bước giá giao dịch của mã không hợp lệ");
   StringReplace(text,"Closed LTF candle time unavailable","Chưa có thời điểm nến LTF đóng");
