DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# PostgreSQL 17 is the default database. Use either DATABASE_URL or the POSTGRES_* fields.
# DATABASE_URL=postgresql://ict_user:URL-ENCODED-PASSWORD@127.0.0.1:5432/ict_ai_learning
DATABASE_ENGINE=postgresql
POSTGRES_DB=ict_ai_learning
POSTGRES_USER=ict_user
POSTGRES_PASSWORD=replace-with-your-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
YOUTUBE_API_KEY=
YOUTUBE_API_TIMEOUT=20
